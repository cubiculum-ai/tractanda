+// Copyright © 2024 Apple Inc.
+// Adapted from the pinned local VLM factory; retained upstream license applies.
+// Linux-only, package-private pinned-profile adapter. Original Mac factory and
+// Idefics3 model arithmetic remain unchanged. No media preprocessing lives here.
+#if os(Linux)
+import Foundation
+import MLX
+import MLXLMCommon
+
+private struct NativeDocumentProcessorRequired: UserInputProcessor {
+    func prepare(input: UserInput) async throws -> LMInput {
+        throw ModelFactoryError.unsupportedModelType("Install NativeDocumentInput before preparing the pinned document page")
+    }
+}
+public final class VLMModelFactory: ModelFactory {
+    public static let shared = VLMModelFactory()
+    public let modelRegistry: AbstractModelRegistry = AbstractModelRegistry()
+    private init() {}
+
+    public func _load(
+        configuration: ResolvedModelConfiguration, tokenizerLoader: any TokenizerLoader
+    ) async throws -> sending ModelContext {
+        let directory = configuration.modelDirectory
+        guard directory.isFileURL,
+            configuration.tokenizerDirectory.standardizedFileURL == directory.standardizedFileURL
+        else { throw ModelFactoryError.unsupportedModelType("Pinned Docling requires its local tokenizer assets") }
+        // The converter verifies these exact 14 hashes before entering this
+        // factory. Reject loader-changing sidecars and additional weight shards.
+        let allowed: Set<String> = [
+            "README.md", "config.json", "preprocessor_config.json", "processor_config.json",
+            "chat_template.jinja", "generation_config.json", "tokenizer.json", "tokenizer_config.json",
+            "special_tokens_map.json", "added_tokens.json", "merges.txt", "vocab.json",
+            "model.safetensors.index.json", "model.safetensors",
+        ]
+        let files = try FileManager.default.contentsOfDirectory(atPath: directory.path)
+        guard Set(files) == allowed else {
+            throw ModelFactoryError.unsupportedModelType("Foreign or incomplete pinned document assets")
+        }
+        let configData = try Data(contentsOf: directory.appendingPathComponent("config.json"))
+        let dictionary = try JSONSerialization.jsonObject(with: configData) as? [String: Any]
+        guard dictionary?["model_type"] as? String == "idefics3",
+            dictionary?["quantization"] == nil, dictionary?["quantization_config"] == nil,
+            dictionary?["weight_format"] == nil, dictionary?["mtp"] == nil
+        else { throw ModelFactoryError.unsupportedModelType("Only the pinned unquantized Idefics3 document profile is supported") }
+        let base = try JSONDecoder.json5().decode(BaseConfiguration.self, from: configData)
+        let config = try JSONDecoder.json5().decode(Idefics3Configuration.self, from: configData)
+        guard config.visionConfig.imageSize == 512, config.visionConfig.patchSize == 16,
+            config.scaleFactor == 4, config.imageTokenIndex == 100270 else {
+            throw ModelFactoryError.unsupportedModelType("Pinned document model geometry differs")
+        }
+        let processorData = try Data(contentsOf: directory.appendingPathComponent("preprocessor_config.json"))
+        _ = try JSONDecoder.json5().decode(Idefics3ProcessorConfiguration.self, from: processorData)
+        let processor = try JSONSerialization.jsonObject(with: processorData) as? [String: Any]
+        guard processor?["processor_class"] as? String == "Idefics3Processor",
+            processor?["image_mean"] as? [Double] == [0.5, 0.5, 0.5],
+            processor?["image_std"] as? [Double] == [0.5, 0.5, 0.5],
+            (processor?["size"] as? [String: Int])?["longest_edge"] == 2048,
+            (processor?["max_image_size"] as? [String: Int])?["longest_edge"] == 512
+        else { throw ModelFactoryError.unsupportedModelType("Pinned document processor profile differs") }
+        let generation = try JSONDecoder.json5().decode(
+            GenerationConfigFile.self,
+            from: Data(contentsOf: directory.appendingPathComponent("generation_config.json")))
+        let eos = ModelTokenConfigurationResolver.resolvedEOSTokenIds(
+            baseConfig: base, configurationData: configData, generationConfig: generation)
+        guard eos == [100257] else {
+            throw ModelFactoryError.unsupportedModelType("Pinned document EOS differs")
+        }
+        let model = Idefics3(config)
+        // Same pinned common loader/sanitize route as the Mac factory, with no
+        // JANG, quantization, preserved MTP, remote resolver or tokenizer fallback.
+        try loadWeights(modelDirectory: directory, model: model)
+        let tokenizer = try await tokenizerLoader.load(from: directory)
+        let modelConfig = ModelConfiguration(
+            directory: directory, defaultPrompt: configuration.defaultPrompt,
+            extraEOSTokens: configuration.extraEOSTokens, eosTokenIds: eos,
+            toolCallFormat: configuration.toolCallFormat ?? ToolCallFormat.infer(from: base.modelType),
+            reasoningParserName: configuration.reasoningParserName ?? "none",
+            generationDefaults: generation,
+            mtpStatus: try? MTPBundleInspector.inspect(modelDirectory: directory, jangConfig: nil))
+        return ModelContext(configuration: modelConfig, model: model,
+            processor: NativeDocumentProcessorRequired(), tokenizer: tokenizer)
+    }
+}
+#endif
