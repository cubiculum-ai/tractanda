#!/bin/sh
set -eu
case "${1-}" in
 remove|purge)
  [ "$#" -eq 1 ] || { echo "tractanda postrm: invalid remove/purge arguments" >&2; exit 2; }
  action=postrm-remove; reload=1 ;;
 failed-upgrade|abort-upgrade)
  [ "$#" -eq 3 ] || { echo "tractanda postrm: invalid abort arguments" >&2; exit 2; }
  action=postrm; reload=1
  if [ "$1" = abort-upgrade ] && [ "$2" = '0.1.0~poc.16.2-1' ] \
     && [ "$3" = '@TRACTANDA_LAYOUT17_DEBIAN_VERSION@' ] && [ "$3" != '-' ]; then
   action=layout17-abort-upgrade
  elif [ "$1" = abort-upgrade ] && [ "$2" = '@TRACTANDA_LAYOUT17_DEBIAN_VERSION@' ] \
     && [ "$3" = "$2" ] && [ "$3" != '-' ]; then
   action=layout17-reinstall-abort
  elif [ "$1" = abort-upgrade ] && [ "$2" = '0.1.0~poc.17-1' ] \
     && [ "$3" = '@TRACTANDA_LAYOUT17_DEBIAN_VERSION@' ] && [ "$3" != '-' ] \
     && [ "${3#0.1.0~poc.17.1-}" != "$3" ]; then
   action=layout17-compatible-abort
  fi ;;
 abort-install)
  { [ "$#" -eq 1 ] || [ "$#" -eq 3 ]; } || { echo "tractanda postrm: invalid abort-install arguments" >&2; exit 2; }
  action=postrm; reload=1 ;;
 upgrade)
  [ "$#" -eq 2 ] || { echo "tractanda postrm: invalid upgrade cleanup arguments" >&2; exit 2; }
  exit 0 ;;
 disappear)
  [ "$#" -eq 3 ] || { echo "tractanda postrm: invalid disappear arguments" >&2; exit 2; }
  action=uuidd-remove; reload=0 ;;
 *) echo "tractanda postrm: unsupported dpkg action" >&2; exit 2 ;;
esac
# postrm runs after package files and dependency state may have been removed.
# prerm already performed the required quiescence; skip this nonessential
# validation/reload when either declared pre-dependency is unavailable.
if ! [ -x /usr/bin/python3 ] || ! [ -x /usr/bin/systemctl ]; then
 if [ -e /etc/tractanda/uuidd-normal-clock.json ] || [ -e /etc/systemd/system/uuidd.service.d/90-tractanda-normal-clock.conf ]; then
  echo "tractanda postrm: uuidd cleanup requires python3 and systemctl; owned policy retained" >&2
  exit 1
 fi
 exit 0
fi
set -- "$action"
if [ "$action" = layout17-reinstall-abort ] || [ "$action" = layout17-compatible-abort ]; then
 set -- "$action" '@TRACTANDA_LAYOUT17_MANIFEST_SHA256@'
fi
/usr/bin/python3 -I - "$@" <<'TRACTANDA_PACKAGE_HOOK_FALLBACK_EOF'
@TRACTANDA_PACKAGE_HOOK_FALLBACK_PY@
TRACTANDA_PACKAGE_HOOK_FALLBACK_EOF
if [ "$reload" -eq 1 ]; then /usr/bin/systemctl daemon-reload; fi

