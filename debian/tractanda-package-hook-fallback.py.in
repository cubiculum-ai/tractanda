#!/usr/bin/python3
"""Finite Debian hook fallback. It proves OS custody only; it never reads canonical authority."""
import contextlib
import fcntl
import hashlib
import io
import json
import os
import pwd
import platform
import re
import stat
import struct
import subprocess
import sys
import tarfile
import tempfile
import uuid

INSTALLATION = "/opt/tractanda/var/lib/tractanda/Installation"
STATE = os.path.join(INSTALLATION, "package-transaction.json")
RECEIPTS = os.path.join(INSTALLATION, "receipts")
LAYOUT = "current"
LEGACY_ROOT = "/etc/tractanda"
CONFIG_ROOT = "/opt/tractanda/etc/tractanda"
LAYOUT_ALIASES = (
    ("/etc/tractanda", "/opt/tractanda/etc/tractanda"),
    ("/var/lib/tractanda", "/opt/tractanda/var/lib/tractanda"),
    ("/opt/tractanda/var/log/tractanda", "/var/log/tractanda"),
    ("/opt/tractanda/run/tractanda", "/run/tractanda"),
)
ACTIVE = "/opt/tractanda/current"
LAYOUT17_FIRST = "0.1.0-poc.17"
LAYOUT17_CORRECTED = "0.1.0-poc.17.1"
LAYOUT17_POLICIES = {LAYOUT17_FIRST: "coordinated-maintenance", LAYOUT17_CORRECTED: "compatible"}
UNIT_DIR = "/etc/systemd/system"
ROLES = ("server", "embeddings", "authentication")
MAX_BYTES = 1_048_576
DESCRIPTOR_KEYS = {
    "profile", "manifestSHA256", "version", "arch", "canonicalFormats", "semanticProfile", "upgrade",
}
STATE_REQUIRED = {"profile", "operationID", "phase", "instances", "startupPermitted"}
STATE_ALLOWED = STATE_REQUIRED | {"original", "incoming", "observed", "owner", "recoveryReason"}
INSTANCE_KEYS = {
    "name", "originalManifestSHA256", "wasRunning", "wasEnabled",
    "embeddingWasRunning", "authenticationWasRunning",
}
UNIT_PROPERTIES = {
    "LoadState", "ActiveState", "FragmentPath", "DropInPaths",
    "NeedDaemonReload", "MainPID", "UnitFileState",
}

def refuse(message):
    raise SystemExit("tractanda package fallback: " + message)

def root_uid():
    return 0

def root_directory_chain(path):
    if not path.startswith("/"):
        refuse("protected parent is not absolute")
    current = "/"
    for component in path.split("/")[1:]:
        if not component:
            continue
        current = os.path.join(current, component)
        metadata = os.lstat(current)
        if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_mode & 0o022):
            refuse("protected directory ancestry is not root-owned and stable")

def ensure_layout_directory(path):
    """Create only missing protected directories; never follow or chmod an occupant."""
    if os.path.lexists(path):
        root_directory_chain(path)
        return
    parent = os.path.dirname(path)
    ensure_layout_directory(parent)
    # This finite helper is single-threaded. Override the private hook umask
    # only for mkdir so the new directory is traversable at creation, including
    # across interruption; restore before any other operation or private write.
    previous_umask = os.umask(0o022)
    try:
        os.mkdir(path, 0o755)
    except FileExistsError:
        pass
    finally:
        os.umask(previous_umask)
    root_directory_chain(path)
    directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)

def ensure_layout_aliases():
    """Fixed leaf aliases belong to Setup state, outside dpkg-owned current software."""
    for alias, target in LAYOUT_ALIASES:
        ensure_layout_directory(target)
        parent = os.path.dirname(alias)
        ensure_layout_directory(parent)
        if os.path.lexists(alias):
            metadata = os.lstat(alias)
            if (not stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0
                    or metadata.st_nlink != 1 or os.readlink(alias) != target):
                refuse("layout alias is occupied or points outside its exact target")
            continue
        os.symlink(target, alias)
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)

def select_layout():
    """Select a protected proof root, admitting only the pinned migration journal."""
    global STATE, RECEIPTS, LAYOUT, UUIDD_RECEIPT
    STATE = os.path.join(INSTALLATION, "package-transaction.json")
    RECEIPTS = os.path.join(INSTALLATION, "receipts")
    UUIDD_RECEIPT = os.path.join(CONFIG_ROOT, "uuidd-normal-clock.json")
    marker_path = os.path.join(INSTALLATION, "layout-migration.json")
    marker = None
    if os.path.lexists(marker_path):
        marker = decode_object(read_private_regular(marker_path, 16 * 1024 * 1024))
        if (set(marker) != {"version", "platform", "phase", "sourceConfig", "targetConfig", "moves", "originalFiles"}
                or type(marker["version"]) is not int or marker["version"] != 1 or marker["platform"] != "linux"
                or marker["phase"] not in ("preparing", "relocated", "committed")
                or marker["sourceConfig"] != LEGACY_ROOT or marker["targetConfig"] != CONFIG_ROOT
                or type(marker["moves"]) is not list or type(marker["originalFiles"]) is not dict):
            refuse("layout migration journal is not recognized")
    legacy_root = LEGACY_ROOT
    if os.path.islink(LEGACY_ROOT):
        if os.readlink(LEGACY_ROOT) != CONFIG_ROOT:
            refuse("configuration alias points outside the selected physical root")
        legacy = False
    else:
        if not os.path.lexists(LEGACY_ROOT) and marker and marker["phase"] == "relocated":
            legacy_root = LEGACY_ROOT + ".layout-pre20261027"
        legacy_state = os.path.join(legacy_root, "package-transaction.json")
        legacy_receipts = os.path.join(legacy_root, "receipts")
        legacy = os.path.lexists(legacy_state) or os.path.lexists(legacy_receipts)
    current = os.path.lexists(STATE) or os.path.lexists(RECEIPTS)
    if legacy and current and not (marker and marker["phase"] != "committed"):
        refuse("legacy and current installation state coexist without a valid migration")
    if legacy:
        root_directory_chain(legacy_root)
        STATE, RECEIPTS = legacy_state, legacy_receipts
        UUIDD_RECEIPT = os.path.join(legacy_root, "uuidd-normal-clock.json")
        LAYOUT = "legacy"
    elif marker and marker["phase"] != "committed":
        if not current:
            refuse("interrupted migration has no protected package state")
        LAYOUT = "migrating-current"
    else:
        LAYOUT = "current"
    return LAYOUT

def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            refuse("duplicate JSON key")
        value[key] = item
    return value

def read_private_regular(path, maximum=MAX_BYTES, private=True):
    root_directory_chain(os.path.dirname(path))
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0
                or (stat.S_IMODE(before.st_mode) != 0o600 if private else bool(before.st_mode & 0o022))
                or before.st_nlink != 1
                or before.st_size <= 0 or before.st_size > maximum):
            refuse("protected file has unsafe type, owner, mode or size")
        data = bytearray()
        while len(data) <= maximum:
            block = os.read(fd, min(65_536, maximum + 1 - len(data)))
            if not block:
                break
            data.extend(block)
        after = os.fstat(fd)
        identity = lambda item: (
            item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns, item.st_ctime_ns)
        if len(data) != before.st_size or len(data) > maximum or identity(before) != identity(after):
            refuse("protected file changed while reading")
        return bytes(data)
    finally:
        os.close(fd)

def decode_object(data, required=None, allowed=None):
    try:
        value = json.loads(data, object_pairs_hook=unique_object)
    except SystemExit:
        raise
    except Exception as error:
        refuse("invalid bounded JSON: " + type(error).__name__)
    if type(value) is not dict:
        refuse("JSON value is not an object")
    if required is not None and not required <= set(value):
        refuse("required JSON fields are missing")
    if allowed is not None and not set(value) <= allowed:
        refuse("unknown JSON fields are present")
    return value

def valid_digest(value):
    return type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value) is not None

def valid_instance(value):
    return (type(value) is str and value.isascii() and 1 <= len(value) <= 32
            and value[0] != "-" and value[-1] != "-"
            and all(character.isalnum() or character == "-" for character in value))

def run_systemctl(arguments, allow_not_found=False):
    try:
        result = subprocess.run(
            ["/usr/bin/systemctl", *arguments], stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, timeout=10, check=False)
    except Exception as error:
        refuse("cannot prove systemd state: " + type(error).__name__)
    # systemd 257 returns one for this exact empty unit-file inventory.
    # A diagnostic, different query/status, or any output remains a failure.
    if (tuple(arguments) == ("list-unit-files", "--no-legend", "--no-pager", "tractanda-*.service")
            and result.returncode == 1 and result.stdout == "" and result.stderr == ""):
        return ""
    if result.returncode != 0:
        fields = {}
        for line in result.stdout.splitlines():
            key, separator, value = line.partition("=")
            if not separator or key in fields:
                refuse("systemd error state is malformed")
            fields[key] = value
        if (not allow_not_found or set(fields) != UNIT_PROPERTIES
                or fields["LoadState"] != "not-found" or fields["ActiveState"] != "inactive"
                or fields["MainPID"] != "0" or fields["FragmentPath"] or fields["DropInPaths"]
                or fields["NeedDaemonReload"] not in ("", "no")
                or fields["UnitFileState"] not in ("", "not-found", "disabled")):
            refuse("systemd state query failed")
    return result.stdout

def listed_units(arguments):
    names = set()
    for line in run_systemctl(arguments).splitlines():
        fields = line.split()
        if (not fields or fields[0] in names or not fields[0].startswith("tractanda-")
                or not fields[0].endswith(".service")):
            refuse("managed-unit inventory is malformed")
        names.add(fields[0])
    return names

def hash_owned_unit(path, expected):
    root_directory_chain(os.path.dirname(path))
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_nlink != 1
                or before.st_mode & 0o022 or not valid_digest(expected)):
            refuse("unit file is not a protected receipt-bound regular file")
        digest = hashlib.sha256()
        while True:
            block = os.read(fd, 65_536)
            if not block:
                break
            digest.update(block)
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
                after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            refuse("unit file changed while hashing")
        if digest.hexdigest() != expected:
            refuse("unit file differs from its receipt hash")
    finally:
        os.close(fd)

def hash_payload_file(path, expected_size, expected_mode):
    root_directory_chain(os.path.dirname(path))
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_nlink != 1
                or stat.S_IMODE(before.st_mode) != expected_mode or before.st_mode & 0o022
                or before.st_size != expected_size):
            refuse("active payload file differs from its protected manifest metadata")
        digest = hashlib.sha256()
        while True:
            block = os.read(fd, 1_048_576)
            if not block:
                break
            digest.update(block)
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
                after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            refuse("active payload file changed while hashing")
        return digest.hexdigest()
    finally:
        os.close(fd)

def verify_helper(arguments):
    if len(arguments) != 2 or os.geteuid() != 0:
        refuse("helper admission requires root and one fixed helper path")
    expected_path = os.path.join(ACTIVE, "bin", "tractanda-setup")
    if arguments[1] != expected_path:
        refuse("helper path differs from the fixed active package path")
    root_directory_chain(ACTIVE)
    manifest_path = os.path.join(ACTIVE, "bundle-manifest.json")
    raw = read_private_regular(manifest_path, 16 * 1024 * 1024, private=False)
    manifest = decode_object(raw)
    machine = platform.machine().lower()
    host_arch = "arm64" if machine in ("aarch64", "arm64") else "x86_64" if machine in ("x86_64", "amd64") else ""
    if (manifest.get("profile") != "tractanda.bundle.v1" or manifest.get("platform") != "linux"
            or manifest.get("arch") != host_arch or not isinstance(manifest.get("files"), list)
            or len(manifest["files"]) > 20_000):
        refuse("active bundle manifest is not a supported Linux payload")
    entries = [entry for entry in manifest["files"]
               if type(entry) is dict and entry.get("path") == "bin/tractanda-setup"]
    if len(entries) != 1:
        refuse("active bundle manifest does not uniquely declare Setup")
    entry = entries[0]
    size, mode, digest = entry.get("size"), entry.get("mode"), entry.get("sha256")
    if (type(size) is not int or size <= 0 or size > 8 * 1024 * 1024 * 1024
            or type(mode) is not int or mode & 0o111 == 0 or mode & 0o022
            or not valid_digest(digest)):
        refuse("active Setup manifest entry is invalid")
    if hash_payload_file(expected_path, size, mode) != digest:
        refuse("active Setup executable hash differs from its protected manifest")
    manifest_digest = hashlib.sha256(raw).hexdigest()
    commitments = set()
    state_present = False
    try:
        os.lstat(STATE)
        state_present = True
        state = decode_object(read_private_regular(STATE), STATE_REQUIRED, STATE_ALLOWED)
        try:
            operation = uuid.UUID(state["operationID"])
        except Exception:
            refuse("package transaction operation ID is invalid")
        if (state.get("profile") != "tractanda.package-transaction.v1"
                or operation.version != 1 or state["operationID"] != str(operation)
                or state.get("phase") not in (
                    "quiescing", "quiesced", "awaitingUnpack", "configuring", "failed", "committed", "removed")
                or type(state.get("instances")) is not list or len(state["instances"]) > 1024
                or type(state.get("startupPermitted")) is not list):
            refuse("package transaction profile differs")
        for key in ("original", "incoming", "observed"):
            value = state.get(key)
            if value is not None:
                if type(value) is not dict or not valid_digest(value.get("manifestSHA256")):
                    refuse("package transaction compatibility commitment is invalid")
                commitments.add(value["manifestSHA256"])
    except FileNotFoundError:
        pass
    try:
        directory = os.lstat(RECEIPTS)
    except FileNotFoundError:
        directory = None
    if directory is not None:
        root_directory_chain(os.path.dirname(RECEIPTS))
        if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or directory.st_mode & 0o022:
            refuse("receipt directory has unsafe custody")
        names = os.listdir(RECEIPTS)
        if len(names) > 1024:
            refuse("receipt inventory exceeds its bound")
        receipt_digests = set()
        for filename in names:
            if not filename.endswith(".json") or not valid_instance(filename[:-5]):
                refuse("receipt inventory contains an unknown entry")
            receipt = decode_object(read_private_regular(os.path.join(RECEIPTS, filename)))
            if (receipt.get("instance") != filename[:-5]
                    or not valid_digest(receipt.get("manifestSHA256"))):
                refuse("receipt manifest commitment is invalid")
            receipt_digests.add(receipt["manifestSHA256"])
        if state_present:
            if not receipt_digests <= commitments:
                refuse("receipt manifest is outside the transaction's original/incoming/observed commitments")
        else:
            if len(receipt_digests) != 1:
                refuse("untracked receipts do not share one package manifest")
            commitments.update(receipt_digests)
    if commitments and manifest_digest not in commitments:
        refuse("active manifest has no package-state or receipt commitment")
    return 0

def inspect_units(instances, receipts):
    expected = {"tractanda-" + role + "-" + name + ".service"
                for name in instances for role in ROLES}
    listed = listed_units((
        "list-units", "--all", "--no-legend", "--plain", "--full",
        "--type=service", "tractanda-*.service"))
    enabled = listed_units(("list-unit-files", "--no-legend", "--no-pager", "tractanda-*.service"))
    if not listed <= expected or not enabled <= expected:
        refuse("unowned managed unit exists")
    for name in instances:
        inspect_stopped_instance(name, receipts[name])


def inspect_stopped_instance(name, receipt):
    property_argument = "--property=LoadState,ActiveState,FragmentPath,DropInPaths,NeedDaemonReload,MainPID,UnitFileState"
    hashes = {
        "server": receipt.get("definitionSHA256"),
        "embeddings": receipt.get("embeddingDefinitionSHA256"),
        "authentication": receipt.get("authenticationDefinitionSHA256"),
    }
    for role, expected_hash in hashes.items():
        unit = "tractanda-" + role + "-" + name + ".service"
        output = run_systemctl(("show", unit, "--no-pager", property_argument), allow_not_found=True)
        fields = {}
        for line in output.splitlines():
            key, separator, value = line.partition("=")
            if not separator or key in fields:
                refuse("systemd state is incomplete or duplicated")
            fields[key] = value
        if set(fields) != UNIT_PROPERTIES or fields["MainPID"] != "0" or fields["DropInPaths"]:
            refuse("managed unit has a process or unknown override")
        path = os.path.join(UNIT_DIR, unit)
        if fields["LoadState"] == "not-found":
            if (fields["ActiveState"] != "inactive" or fields["FragmentPath"]
                    or fields["UnitFileState"] not in ("", "not-found", "disabled")):
                refuse("missing unit has contradictory state")
        elif (fields["LoadState"] != "loaded" or fields["ActiveState"] not in ("inactive", "failed")
                or fields["NeedDaemonReload"] != "no" or fields["UnitFileState"] != "disabled"
                or fields["FragmentPath"] != path):
            refuse("unit is not owned, stopped and disabled")
        try:
            metadata = os.lstat(path)
        except FileNotFoundError:
            metadata = None
        if metadata is not None:
            hash_owned_unit(path, expected_hash)
        elif expected_hash is not None:
            refuse("receipt-owned unit definition disappeared")
        dropins = path + ".d"
        try:
            drop_metadata = os.lstat(dropins)
        except FileNotFoundError:
            drop_metadata = None
        if drop_metadata is not None and (
                not stat.S_ISDIR(drop_metadata.st_mode) or os.listdir(dropins)):
            refuse("unit drop-in directory is not empty")

def private_directory(path, daemon_uid):
    root_directory_chain(os.path.dirname(path))
    metadata = os.lstat(path)
    if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != daemon_uid
            or stat.S_IMODE(metadata.st_mode) != 0o700):
        refuse("store or index is not a private daemon-owned directory")

def receipt_instance_paths(receipt, name, daemon_uid):
    paths = []
    roots = []
    for key in ("store", "indexDirectory"):
        path = receipt.get(key)
        if (type(path) is not str or not path.startswith("/") or path == "/"
                or os.path.normpath(path) != path or "\x00" in path
                or os.path.basename(path) != name):
            refuse("receipt path is not normalized and instance-bound")
        parent = os.path.dirname(path)
        if parent == "/":
            refuse("receipt root must not be the filesystem root")
        paths.append(path)
        roots.append(parent)
    first, second = roots
    if (first == second or first.startswith(second + "/")
            or second.startswith(first + "/")):
        refuse("receipt store and index roots overlap")
    for path in paths:
        private_directory(path, daemon_uid)
    return paths

def read_receipts(instances, quiescent=True):
    root_directory_chain(os.path.dirname(RECEIPTS))
    try:
        directory = os.lstat(RECEIPTS)
    except FileNotFoundError:
        if instances:
            refuse("transaction names instances but receipts are absent")
        return {}
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or directory.st_mode & 0o022:
        refuse("receipt directory has unsafe custody")
    if len(instances) > 1024 or set(os.listdir(RECEIPTS)) != {name + ".json" for name in instances}:
        refuse("receipt inventory differs from transaction")
    try:
        daemon_uid = pwd.getpwnam("daemon").pw_uid
    except KeyError:
        refuse("existing daemon account is missing")
    receipts = {}
    for name in instances:
        receipt = decode_object(read_private_regular(os.path.join(RECEIPTS, name + ".json")))
        if (receipt.get("version") != 1 or receipt.get("instance") != name
                or receipt.get("release") != ACTIVE or not valid_digest(receipt.get("manifestSHA256"))
                or type(receipt.get("initialized")) is not bool
                or receipt.get("state") not in ("preparing", "active", "removed")):
            refuse("receipt is not a recognized dpkg-owned registration")
        if ("packageDefinitions" in receipt
                and receipt["packageDefinitions"] not in (None, {})):
            refuse("owned service-definition publication is pending native recovery")
        if quiescent or receipt["state"] != "removed":
            receipt_instance_paths(receipt, name, daemon_uid)
        if not quiescent:
            receipts[name] = receipt
            continue
        lock_path = os.path.join(receipt["store"], ".writer.lock")
        lock_info = os.lstat(lock_path)
        if (not stat.S_ISREG(lock_info.st_mode) or lock_info.st_uid != daemon_uid
                or stat.S_IMODE(lock_info.st_mode) != 0o600 or lock_info.st_nlink != 1):
            refuse("existing private writer lock has unsafe custody")
        fd = os.open(lock_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            refuse("canonical writer lock is held")
        finally:
            os.close(fd)
        receipts[name] = receipt
    return receipts

def safe_state():
    state = decode_object(read_private_regular(STATE), STATE_REQUIRED, STATE_ALLOWED)
    try:
        operation = uuid.UUID(state["operationID"])
    except Exception:
        refuse("transaction operation ID is invalid")
    if (state["profile"] != "tractanda.package-transaction.v1" or operation.version != 1
            or state["operationID"] != str(operation) or state["phase"] not in (
                "quiesced", "awaitingUnpack", "failed", "removed", "committed")
            or state["startupPermitted"] != [] or state.get("owner") is not None
            or type(state["instances"]) is not list or len(state["instances"]) > 1024):
        refuse("transaction is not a recognized quiescent state")
    instances = {}
    for entry in state["instances"]:
        if (type(entry) is not dict or set(entry) != INSTANCE_KEYS
                or not valid_instance(entry.get("name"))
                or not valid_digest(entry.get("originalManifestSHA256"))
                or any(type(entry.get(key)) is not bool for key in (
                    "wasRunning", "wasEnabled", "embeddingWasRunning", "authenticationWasRunning"))
                or entry["name"] in instances):
            refuse("transaction instance record is malformed")
        instances[entry["name"]] = entry
    receipts = read_receipts(set(instances))
    allowed_manifests = {
        entry["originalManifestSHA256"] for entry in instances.values()
    }
    for key in ("original", "incoming", "observed"):
        declaration = state.get(key)
        if declaration is not None:
            if type(declaration) is not dict or not valid_digest(declaration.get("manifestSHA256")):
                refuse("transaction payload commitment is malformed")
            allowed_manifests.add(declaration["manifestSHA256"])
    if any(receipts[name]["manifestSHA256"] != entry["originalManifestSHA256"]
           and receipts[name]["manifestSHA256"] not in allowed_manifests
           for name, entry in instances.items()):
        refuse("receipt manifest is outside original/incoming/observed package commitments")
    inspect_units(set(instances), receipts)
    return state

def validate_descriptor(path):
    allowed = DESCRIPTOR_KEYS | {"embedding", "documentExtraction"}
    descriptor = decode_object(read_private_regular(path, 65_536), DESCRIPTOR_KEYS, allowed)
    if (descriptor["profile"] != "tractanda.linux-package.v1"
            or not valid_digest(descriptor["manifestSHA256"])
            or descriptor["arch"] not in ("x86_64", "arm64")
            or type(descriptor["canonicalFormats"]) is not dict
            or type(descriptor["version"]) is not str or not descriptor["version"]
            or len(descriptor["version"].encode()) > 80
            or type(descriptor["semanticProfile"]) is not str
            or not descriptor["semanticProfile"] or len(descriptor["semanticProfile"].encode()) > 128
            or descriptor["upgrade"] not in ("compatible", "coordinated-maintenance")):
        refuse("incoming package descriptor is invalid")
    if any(key in descriptor and type(descriptor[key]) is not dict
           for key in ("embedding", "documentExtraction")):
        refuse("bundled feature descriptor has an invalid shape")
    return descriptor

def write_state(state):
    encoded = (json.dumps(state, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n").encode()
    if len(encoded) > MAX_BYTES:
        refuse("transaction exceeds its bound")
    parent = os.path.dirname(STATE)
    root_directory_chain(parent)
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    temporary = os.path.join(parent, ".package-transaction.fallback." + str(os.getpid()))
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        with os.fdopen(fd, "wb", closefd=False) as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(fd)
        os.replace(temporary, STATE)
        os.fsync(parent_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        os.close(fd)
        os.close(parent_fd)

LEGACY_DEBIAN_VERSIONS = {
    "0.1.0~poc.15-1+personal.1793193134.fdaf8ff8b393": "0.1.0-poc.15",
    "0.1.0~poc.16-1": "0.1.0-poc.16",
    "0.1.0~poc.16.1-1": "0.1.0-poc.16.1",
    "0.1.0~poc.16.2-1": "0.1.0-poc.16.2",
}

def layout17_store_file(store, name, daemon_uid):
    """Bounded read-only operational metadata; never interpret an item or rewrite content."""
    root = os.open(store, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        parent = os.fstat(root)
        if parent.st_uid != daemon_uid or stat.S_IMODE(parent.st_mode) != 0o700:
            refuse("layout17 store is not private service-owned data")
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=root)
        try:
            before = os.fstat(fd)
            if (not stat.S_ISREG(before.st_mode) or before.st_uid != daemon_uid or before.st_nlink != 1
                    or stat.S_IMODE(before.st_mode) != 0o600 or not 0 < before.st_size <= 131072):
                refuse("layout17 operational metadata is unsafe")
            raw = bytearray()
            while len(raw) < before.st_size:
                part = os.read(fd, before.st_size - len(raw))
                if not part:
                    refuse("layout17 operational metadata changed")
                raw.extend(part)
            after = os.fstat(fd)
            named = os.stat(name, dir_fd=root, follow_symlinks=False)
            stamp = lambda value: (value.st_dev, value.st_ino, value.st_mode, value.st_uid,
                                   value.st_nlink, value.st_size, value.st_mtime_ns, value.st_ctime_ns)
            if stamp(before) != stamp(after) or stamp(after) != stamp(named):
                refuse("layout17 operational metadata changed")
            return bytes(raw)
        finally:
            os.close(fd)
    finally:
        os.close(root)


_LAYOUT17_DOCUMENT_KEYS = {
    "converterPath", "identity", "workerProtocol", "modelDirectory", "modelManifestPath",
    "modelManifestSHA256", "runtimeRepository", "runtimePatchManifestPath", "runtimePatchManifestSHA256",
    "runtimePatchIdentifier", "runtimePatchPath", "runtimePatchSHA256", "noticePaths",
}
_LAYOUT17_IDENTITY_KEYS = {"converter", "model", "modelRevision", "runtimeRevision", "preprocessing", "parser"}


def layout17_document_semantics(document):
    """Mirror DocumentConverterIdentity.storedSemanticProfile, without changing provenance.

    This is a read-compatibility projection only. The authenticated new Setup still compares
    the genuine incoming descriptor with the actual unpacked executable/model/runtime closure.
    """
    if document is None:
        return None
    if (type(document) is not dict or set(document) != _LAYOUT17_DOCUMENT_KEYS
            or document.get("workerProtocol") != "tractanda.native-document-worker.v1"):
        refuse("unknown layout17 document payload schema or worker protocol")
    def relative_path(value):
        return (type(value) is str and 0 < len(value.encode("utf-8")) <= 4096
                and not value.startswith("/") and re.search(r"[\x00-\x1f\x7f]", value) is None
                and all(part not in ("", ".", "..") for part in value.split("/")))
    for key in ("converterPath", "modelDirectory", "modelManifestPath", "runtimePatchManifestPath", "runtimePatchPath"):
        if not relative_path(document.get(key)):
            refuse("malformed layout17 document artifact path")
    for key in ("modelManifestSHA256", "runtimePatchManifestSHA256", "runtimePatchSHA256"):
        if not valid_digest(document.get(key)):
            refuse("malformed layout17 document artifact fingerprint")
    for key in ("runtimeRepository", "runtimePatchIdentifier"):
        value = document.get(key)
        if type(value) is not str or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+./:@_\-]{0,255}", value) is None:
            refuse("malformed layout17 document artifact provenance")
    notices = document.get("noticePaths")
    if type(notices) is not list or len(notices) > 128 or not all(relative_path(value) for value in notices):
        refuse("malformed layout17 document notice inventory")
    identity = document.get("identity")
    if type(identity) is not dict or set(identity) != _LAYOUT17_IDENTITY_KEYS:
        refuse("unknown layout17 document identity schema")
    for key in ("converter", "model"):
        value = identity.get(key)
        if (type(value) is not str or not 1 <= len(value.encode("utf-8")) <= 256
                or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+./:@_\-]*", value) is None):
            refuse("malformed layout17 document provenance identifier")
    for key in ("modelRevision", "runtimeRevision"):
        value = identity.get(key)
        if type(value) is not str or re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", value) is None:
            refuse("malformed layout17 document provenance revision")
    if identity.get("parser") != "doctags-strict-v1":
        refuse("unknown layout17 stored document parser semantics")
    profiles = {
        "opaque-rgb-content-crop-hf4561-pillow123-grid-v2": "contentCropV2",
        "opaque-rgb2048-17tiles-v1": "legacyCanvasV1",
    }
    preprocessing = identity.get("preprocessing")
    if type(preprocessing) is not str or preprocessing not in profiles:
        refuse("unknown layout17 stored document preprocessing semantics")
    return profiles[preprocessing]


_LAYOUT17_INSPECTOR = "bin/tractanda-layout17"
_LAYOUT17_CONTROL_MAXIMUM = 128 * 1024**2
_LAYOUT17_LOADER = {"amd64": "/lib64/ld-linux-x86-64.so.2", "arm64": "/lib/ld-linux-aarch64.so.1"}
_CONTROL_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}


def layout17_native_command(arguments):
    # A verified inspector may take as long as it needs to read the bounded store.
    return subprocess.run(arguments, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, env=_CONTROL_ENV, text=True, check=False)


def layout17_elf_dependencies(path, arch):
    """Read only bounded ELF64 program/dynamic metadata, without an end-user binutils dependency."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_mode & 0o022
                or not 64 <= before.st_size <= 256 * 1024**2):
            refuse("unsafe layout17 ELF dependency")
        def read(offset, size):
            if offset < 0 or size < 0 or offset + size > before.st_size:
                refuse("layout17 ELF metadata is out of bounds")
            data = os.pread(fd, size, offset)
            if len(data) != size:
                refuse("layout17 ELF metadata is truncated")
            return data
        header = read(0, 64)
        if (header[:7] != b"\x7fELF\x02\x01\x01"
                or struct.unpack_from("<H", header, 16)[0] not in (2, 3)
                or struct.unpack_from("<H", header, 18)[0] != {"amd64": 62, "arm64": 183}[arch]):
            refuse("layout17 dependency has an unsupported ELF architecture")
        offset = struct.unpack_from("<Q", header, 32)[0]
        width, count = struct.unpack_from("<HH", header, 54)
        if width != 56 or not 1 <= count <= 256:
            refuse("layout17 ELF program header bound exceeded")
        segments = [struct.unpack("<IIQQQQQQ", read(offset + index * width, width))
                    for index in range(count)]
        dynamic = [row for row in segments if row[0] == 2]
        if len(dynamic) != 1 or not 16 <= dynamic[0][5] <= 131072 or dynamic[0][5] % 16:
            refuse("layout17 ELF dynamic table is invalid")
        table = read(dynamic[0][2], dynamic[0][5])
        tags = []
        for index in range(0, len(table), 16):
            tag, value = struct.unpack_from("<qQ", table, index)
            if tag == 0:
                break
            tags.append((tag, value))
        else:
            refuse("layout17 ELF dynamic table is unterminated")
        addresses = [value for tag, value in tags if tag == 5]
        sizes = [value for tag, value in tags if tag == 10]
        if len(addresses) != 1 or len(sizes) != 1 or not 1 <= sizes[0] <= before.st_size:
            refuse("layout17 ELF string table is invalid")
        mapped = [row[2] + addresses[0] - row[3] for row in segments
                  if row[0] == 1 and row[3] <= addresses[0]
                  and addresses[0] + sizes[0] <= row[3] + row[5]]
        if len(mapped) != 1:
            refuse("layout17 ELF string table is unmapped or ambiguous")
        def name(index):
            if index >= sizes[0]:
                refuse("layout17 ELF name exceeds its string table")
            text = read(mapped[0] + index, min(257, sizes[0] - index))
            end = text.find(b"\0")
            if end == -1 or re.fullmatch(rb"[A-Za-z0-9][A-Za-z0-9+_.-]{0,255}", text[:end]) is None:
                refuse("layout17 ELF dependency name is invalid")
            return text[:end].decode("ascii")
        needed = [name(value) for tag, value in tags if tag == 1]
        sonames = [name(value) for tag, value in tags if tag == 14]
        if len(needed) > 256 or len(set(needed)) != len(needed) or len(sonames) > 1:
            refuse("layout17 ELF dependency count or identity is invalid")
        after = os.fstat(fd)
        named = os.stat(path, follow_symlinks=False)
        stamp = lambda row: (row.st_dev, row.st_ino, row.st_mode, row.st_uid, row.st_size,
                             row.st_mtime_ns, row.st_ctime_ns)
        if stamp(before) != stamp(after) or stamp(after) != stamp(named):
            refuse("layout17 ELF dependency changed during inspection")
        return needed, sonames[0] if sonames else None
    finally:
        os.close(fd)


def layout17_package_record(package, arch, records):
    if package not in records:
        if len(records) >= 256 or re.fullmatch(r"[a-z0-9][a-z0-9+.-]{0,127}", package) is None:
            refuse("layout17 Debian dependency graph exceeds its bound")
        result = layout17_native_command(["/usr/bin/dpkg-query", "-W",
            "-f=${Status}\t${Version}\t${Architecture}\t${Depends}\t${Pre-Depends}\t${Provides}\n", package])
        if len(result.stdout.encode()) > 65536:
            refuse("layout17 Debian dependency metadata exceeds its bound")
        fields = result.stdout.rstrip("\n").split("\t")
        if result.returncode == 1 or (not result.returncode and len(fields) == 6
                                     and fields[0] != "install ok installed"):
            records[package] = None
        elif (result.returncode or result.stderr or len(fields) != 6
                or fields[0] != "install ok installed" or fields[2] not in (arch, "all")):
            refuse("layout17 Debian dependency is not configured for this architecture")
        else:
            records[package] = fields
    return records[package]


def layout17_declared_dependency(source, target, arch, records):
    """An ELF edge must also be backed by current configured Debian dependency metadata."""
    target_record = layout17_package_record(target, arch, records)
    if target_record is None:
        return False
    provided = {target: target_record[1]}
    for value in target_record[5].split(",") if target_record[5] else []:
        match = re.fullmatch(r"\s*([a-z0-9][a-z0-9+.-]*)(?:\s*\(=\s*([^ ()]+)\))?\s*", value)
        if match is None:
            refuse("unsupported layout17 Debian Provides metadata")
        provided[match[1]] = match[2]
    pending, seen, scheduled, edges = [source], set(), {source}, set()
    while pending:
        package = pending.pop()
        if package in seen:
            continue
        seen.add(package)
        record = layout17_package_record(package, arch, records)
        if record is None:
            continue
        for alternative in re.split(r"[,|]", ",".join(record[3:5])):
            if not alternative.strip():
                continue
            match = re.fullmatch(r"\s*([a-z0-9][a-z0-9+.-]*)(?::(any|native|amd64|arm64))?"
                                 r"(?:\s*\((<<|<=|=|>=|>>)\s*([^ ()]+)\))?\s*", alternative)
            if match is None:
                refuse("unsupported layout17 Debian dependency metadata")
            name, qualifier, relation, minimum = match.groups()
            edge = (package, name, qualifier, relation, minimum)
            if edge in edges:
                continue
            edges.add(edge)
            if len(edges) > 4096:
                refuse("layout17 Debian dependency edge bound exceeded")
            if qualifier not in (None, "any", "native", arch):
                continue
            if name in provided:
                version = provided[name]
            else:
                candidate = layout17_package_record(name, arch, records)
                if candidate is None:
                    continue
                version = candidate[1]
            if relation and (version is None or layout17_native_command(
                    ["/usr/bin/dpkg", "--compare-versions", version, relation, minimum]).returncode):
                continue
            if name in provided:
                return True
            if name not in scheduled:
                if len(scheduled) >= 256:
                    refuse("layout17 Debian dependency worklist bound exceeded")
                scheduled.add(name)
                pending.append(name)
    return False


def layout17_check_loader(stage, inventory):
    arch = inventory["arch"]
    loader = _LAYOUT17_LOADER[arch]
    private = inventory["privateSONAMEs"]
    system = inventory["systemLibraries"]
    expected = set(private) | set(system)
    loader_name = os.path.basename(loader)
    if loader_name not in system or "libsqlite3.so.0" not in expected:
        refuse("layout17 loader or SQLite is outside its admitted closure")
    result = layout17_native_command([loader, "--list", os.path.join(stage, _LAYOUT17_INSPECTOR)])
    if result.returncode or result.stderr or len(result.stdout.encode()) > 65536:
        refuse("layout17 inspector runtime closure could not load")
    observed, paths, providers, records = set(), {}, {}, {}
    for line in result.stdout.splitlines():
        line = line.strip()
        if re.fullmatch(r"linux-vdso\.so\.1 \(0x[0-9a-f]+\)", line):
            continue
        mapping = re.fullmatch(r"([^ ]+) => (/[^ ]+) \(0x[0-9a-f]+\)", line)
        if mapping:
            name, path = mapping.groups()
        else:
            direct = re.fullmatch(r"(/[^ ]+) \(0x[0-9a-f]+\)", line)
            if direct is None or os.path.realpath(direct[1]) != os.path.realpath(loader):
                refuse("layout17 inspector loader reported an unknown dependency")
            name, path = loader_name, direct[1]
        if len(observed) >= 512:
            refuse("layout17 loader dependency graph exceeds its bound")
        if name in observed:
            refuse("layout17 inspector loader reported a duplicate dependency")
        observed.add(name)
        physical = os.path.realpath(path)
        paths[name] = physical
        if name in private:
            if physical != os.path.join(stage, private[name]):
                refuse("layout17 private runtime dependency resolved outside its verified copy")
            continue
        if not physical.startswith("/usr/lib/"):
            refuse("layout17 system dependency resolved outside Debian libraries")
        root_directory_chain(os.path.dirname(physical))
        metadata = os.lstat(physical)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o022:
            refuse("layout17 system dependency has unsafe custody")
        ownership = layout17_native_command(["/usr/bin/dpkg-query", "--search", path, physical])
        if len(ownership.stdout.encode()) > 65536:
            refuse("layout17 Debian ownership metadata exceeds its bound")
        owners = set()
        for row in ownership.stdout.splitlines():
            for candidate in (path, physical):
                suffix = ": " + candidate
                if row.endswith(suffix):
                    owner = row[:-len(suffix)]
                    if re.fullmatch(r"[a-z0-9][a-z0-9+.-]+(?::(?:amd64|arm64))?", owner):
                        owners.add(owner.split(":", 1)[0])
        if ownership.returncode not in (0, 1) or len(owners) != 1:
            refuse("layout17 system dependency has an unexpected Debian provider")
        package = next(iter(owners))
        fields = layout17_package_record(package, arch, records)
        if fields is None or fields[2] != arch:
            refuse("layout17 system dependency is not configured for this architecture")
        providers[name] = package
        if name in system and (package != system[name]["package"] or layout17_native_command(
                ["/usr/bin/dpkg", "--compare-versions", fields[1], "ge", system[name]["version"]]).returncode):
            refuse("layout17 system dependency is not configured at the required version")
    if not set(private) <= observed or loader_name not in observed:
        refuse("layout17 inspector's private runtime or loader is incomplete")
    graph = {}
    for name, path in {"@inspector": os.path.join(stage, _LAYOUT17_INSPECTOR), **paths}.items():
        needed, soname = layout17_elf_dependencies(path, arch)
        if (name != "@inspector" and soname is not None and soname != name) or not set(needed) <= observed:
            refuse("layout17 ELF dependency identity or loader graph differs")
        if name == "@inspector" or name in private:
            if not set(needed) <= expected:
                refuse("layout17 private runtime introduced an uncommitted dependency")
        elif set(needed) & set(private):
            refuse("layout17 system dependency shadows the private runtime")
        graph[name] = needed
    reached, pending = set(), ["@inspector", loader_name]
    while pending:
        name = pending.pop()
        if name in reached:
            continue
        reached.add(name)
        for dependency in graph[name]:
            if (dependency not in expected and name in providers
                    and providers[name] != providers[dependency]
                    and not layout17_declared_dependency(providers[name], providers[dependency], arch, records)):
                refuse("layout17 extra system dependency lacks a declared Debian dependency")
            pending.append(dependency)
    if reached != observed | {"@inspector"}:
        refuse("layout17 loader reported a dependency outside the actual ELF graph")


@contextlib.contextmanager
def layout17_control_inspector(path, expected_sha, incoming):
    if (not valid_digest(expected_sha) or not os.path.isabs(path) or os.path.normpath(path) != path
            or os.path.basename(path) != "layout17-inspector.tar"):
        refuse("layout17 requires the authenticated incoming control inspector")
    raw = read_private_regular(path, _LAYOUT17_CONTROL_MAXIMUM, private=False)
    if hashlib.sha256(raw).hexdigest() != expected_sha:
        refuse("layout17 control inspector archive hash differs from the incoming hook")
    parent = os.path.dirname(path)
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:") as archive:
        members = {}
        for member in archive:
            if (len(members) >= 257 or member.name in members or not member.isfile()
                    or member.uid != 0 or member.gid != 0 or member.mode & ~0o777
                    or member.mode & 0o022 or member.size <= 0):
                refuse("unsafe .17 control inspector archive member")
            members[member.name] = member
        metadata = members.pop("layout17-control.json", None)
        if metadata is None or metadata.size > 65536 or metadata.mode != 0o644:
            refuse("layout17 control inventory is absent or unsafe")
        inventory = decode_object(archive.extractfile(metadata).read())
        arch = {"x86_64": "amd64", "arm64": "arm64"}.get(incoming.get("arch"))
        if (set(inventory) != {"profile", "manifestSHA256", "arch", "files", "privateSONAMEs", "systemLibraries"}
                or inventory["profile"] != "tractanda.layout17-control.v1"
                or inventory["manifestSHA256"] != incoming["manifestSHA256"] or inventory["arch"] != arch
                or arch not in _LAYOUT17_LOADER or type(inventory["files"]) is not list
                or type(inventory["privateSONAMEs"]) is not dict or type(inventory["systemLibraries"]) is not dict):
            refuse("layout17 control inventory is outside the genuine incoming payload commitment")
        rows = {}
        for row in inventory["files"]:
            if type(row) is not dict or set(row) != {"path", "sha256", "size", "mode"}:
                refuse("malformed layout17 control file commitment")
            name = row["path"]
            if (type(name) is not str or not (name == _LAYOUT17_INSPECTOR or name.startswith("lib/"))
                    or any(part in ("", ".", "..") for part in name.split("/"))
                    or re.search(r"[\x00-\x20\x7f]", name) is not None
                    or name in rows or not valid_digest(row["sha256"])):
                refuse("unsafe layout17 control file path or hash")
            member = members.get(name)
            if member is None or member.size != row["size"] or member.mode != row["mode"]:
                refuse("layout17 control file metadata differs")
            rows[name] = row
        private, system = inventory["privateSONAMEs"], inventory["systemLibraries"]
        if (set(rows) != set(members) or _LAYOUT17_INSPECTOR not in rows
                or not rows[_LAYOUT17_INSPECTOR]["mode"] & 0o111
                or set(private.values()) != set(rows) - {_LAYOUT17_INSPECTOR}
                or set(private) & set(system) or len(system) > 256):
            refuse("layout17 control inventory is incomplete")
        if not all(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.+\-]{0,127}", name) for name in set(private) | set(system)):
            refuse("invalid layout17 library name")
        for provider in system.values():
            if (type(provider) is not dict or set(provider) != {"package", "version"}
                    or type(provider["package"]) is not str or type(provider["version"]) is not str
                    or re.fullmatch(r"[a-z0-9][a-z0-9+.-]{1,127}", provider["package"]) is None
                    or re.fullmatch(r"[0-9][0-9A-Za-z.+:~\-]{0,127}", provider["version"]) is None):
                refuse("invalid layout17 Debian dependency commitment")
        capacity = os.statvfs(parent)
        if sum(row["size"] for row in rows.values()) > capacity.f_bavail * capacity.f_frsize:
            refuse("insufficient space for the private layout17 inspector")
        with tempfile.TemporaryDirectory(prefix=".layout17-inspector-", dir=parent) as stage:
            for name, row in rows.items():
                target = os.path.join(stage, name)
                os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
                digest = hashlib.sha256()
                with archive.extractfile(members[name]) as source, open(target, "xb") as destination:
                    for block in iter(lambda: source.read(65536), b""):
                        destination.write(block)
                        digest.update(block)
                if digest.hexdigest() != row["sha256"]:
                    refuse("layout17 control executable or library bytes differ from the payload")
                os.chmod(target, row["mode"])
            layout17_check_loader(stage, inventory)
            yield os.path.join(stage, _LAYOUT17_INSPECTOR)


def layout17_journal_path(store_id, replica_id):
    try:
        ids = (uuid.UUID(store_id), uuid.UUID(replica_id))
    except (AttributeError, ValueError, TypeError):
        refuse("layout17 journal identity is invalid")
    if (tuple(map(str, ids)) != (store_id, replica_id) or ids[0] == ids[1]
            or any(value.version != 1 for value in ids)):
        refuse("layout17 journal identity is invalid")
    return os.path.join(INSTALLATION, "layout17-journals", f"layout17-{store_id}-{replica_id}.json")


def layout17_pre_stop(previous, previous_digest, incoming):
    """The finite16.2 boundary is checked BEFORE asking its authentic helper to stop."""
    capabilities = ["tractanda.physical-layout.flat-items.v1", "tractanda.message-items.v1"]
    before, after = previous.get("canonicalFormats"), incoming.get("canonicalFormats")
    policy = LAYOUT17_POLICIES.get(incoming.get("version"))
    if (previous.get("version") != "0.1.0-poc.16.2" or policy is None
            or incoming.get("upgrade") != policy
            or previous.get("arch") != incoming.get("arch")
            or previous.get("embedding") != incoming.get("embedding")
            or layout17_document_semantics(previous.get("documentExtraction"))
                != layout17_document_semantics(incoming.get("documentExtraction"))
            or type(before) is not dict or type(after) is not dict
            or set(before) != set(after)
            or before.get("profile") != "tractanda.canonical-formats.v1"
            or before.get("readerLevel") != 18 or before.get("writerLevel") != 18
            or after.get("readerLevel") != 20 or after.get("writerLevel") != 20
            or before.get("read") != after.get("read") or before.get("write") != after.get("write")
            or any(capability in before.get("capabilities", []) for capability in capabilities)
            or any(capability in before.get("writeCapabilities", []) for capability in capabilities)
            or after.get("capabilities") != sorted(before.get("capabilities", []) + capabilities)
            or after.get("writeCapabilities") != sorted(before.get("writeCapabilities", []) + capabilities)):
        refuse("not the finite authentic16.2 to17 physical-layout transition")
    daemon_uid = pwd.getpwnam("daemon").pw_uid
    root_directory_chain(os.path.dirname(RECEIPTS))
    if not os.path.lexists(RECEIPTS):
        return {}
    root_directory_chain(RECEIPTS)
    names = os.listdir(RECEIPTS)
    targets = {}
    if len(names) > 1024:
        refuse("layout17 receipt inventory exceeds its bound")
    for filename in names:
        if not filename.endswith(".json") or not valid_instance(filename[:-5]):
            refuse("unknown layout17 receipt entry")
        name = filename[:-5]
        receipt = decode_object(read_private_regular(os.path.join(RECEIPTS, filename)))
        if (receipt.get("version") != 1 or receipt.get("instance") != name
                or not valid_digest(receipt.get("manifestSHA256"))
                or receipt.get("state") not in ("active", "preparing", "removed")):
            refuse("layout17 receipt identity is invalid")
        if receipt["state"] == "removed":
            continue  # Retired data is neither an upgrade target nor a reason to stop services.
        if (receipt.get("instance") != name or receipt.get("release") != ACTIVE
                or receipt.get("manifestSHA256") != previous_digest
                or receipt.get("initialized") is not True or receipt.get("state") != "active"):
            refuse("finish the existing16.2 instance operation before layout17")
        receipt_instance_paths(receipt, name, daemon_uid)
        store = receipt["store"]
        for pending in (".tractanda-first-source.json", ".tractanda-first-source-complete.json",
                        ".personal-membership.pending.json", ".personal-baseline.json",
                        ".tractanda-personal-profile.pending.json", "canonical-layout.pending.json",
                        "canonical-layout.json"):
            if os.path.lexists(os.path.join(store, pending)):
                refuse("finish unsupported pending or historical16.2 operation before layout17")
        profile = decode_object(layout17_store_file(store, ".tractanda-personal-profile.json", daemon_uid))
        fence_raw = layout17_store_file(store, "canonical-reader.json", daemon_uid)
        fence = decode_object(fence_raw)
        if (profile.get("profile") != "tractanda.personal-workgroup.v1"
                or profile.get("storeID") != fence.get("storeID")
                or fence.get("minimumReaderLevel") not in (16, 17, 18)):
            refuse("layout17 supports established personal/workgroup16.2 stores only")
        target = {"store": store, "storeID": profile.get("storeID"), "replicaID": profile.get("replicaID"),
                  "readerRequirementSHA256": hashlib.sha256(fence_raw).hexdigest(), "clustered": False}
        if incoming["version"] == LAYOUT17_CORRECTED:
            journal = layout17_journal_path(target["storeID"], target["replicaID"])
            if os.path.lexists(journal):
                refuse("finish the retained .17 operation using its exact original package")
        targets[name] = target
        membership_path = os.path.join(store, ".personal-membership.json")
        if not os.path.lexists(membership_path):
            continue
        raw_membership = layout17_store_file(store, ".personal-membership.json", daemon_uid)
        membership = decode_object(raw_membership)
        members = membership.get("members")
        if (membership.get("profile") != "tractanda.personal-membership.v1"
                or membership.get("storeID") != profile.get("storeID")
                or type(members) is not list or not 1 <= len(members) <= 256):
            refuse("layout17 current membership is invalid")
        target.update(clustered=len(members) > 1, membershipDigest=hashlib.sha256(raw_membership).hexdigest(),
                      memberCount=len(members))
        if not target["clustered"]:
            continue
        intent_path = os.path.join(INSTALLATION, "layout17-intents", name + ".json")
        if not os.path.lexists(intent_path):
            refuse("cluster layout17 requires prepare before stopping services")
        intent = decode_object(read_private_regular(intent_path))
        keys = {"profile", "mode", "instance", "storePath", "storeID", "replicaID", "oldManifestSHA256",
                "newManifestSHA256", "membershipDigest", "readerRequirementSHA256",
                "acknowledgedAllMembersUpgradedBeforeStart"}
        if (set(intent) != keys or intent["profile"] != "tractanda.layout17-prepare.v1"
                or intent["mode"] != "administrator-coordinated" or intent["instance"] != name
                or intent["storePath"] != store or intent["storeID"] != target["storeID"]
                or intent["replicaID"] != target["replicaID"]
                or intent["oldManifestSHA256"] != previous_digest
                or intent["newManifestSHA256"] != incoming["manifestSHA256"]
                or intent["membershipDigest"] != target["membershipDigest"]
                or intent["readerRequirementSHA256"] != target["readerRequirementSHA256"]
                or intent["acknowledgedAllMembersUpgradedBeforeStart"] is not True):
            refuse("cluster layout17 requires the exact transient administrator prepare intent")
        inspect_stopped_instance(name, receipt)
    return targets


def layout17_inspect_targets(inspector, targets, quiescent=False):
    for name, target in sorted(targets.items()):
        args = [inspector, "inspect", "--store", target["store"]]
        if quiescent:
            args.append("--quiescent")
        result = layout17_native_command(args)
        if result.returncode or len(result.stdout.encode()) > 65536:
            refuse("layout17 inspection refused " + name + ": " + result.stderr.strip()[:1024])
        observed = decode_object(result.stdout)
        if (observed.get("profile") != "tractanda.layout17-inspection.v1"
                or observed.get("phase") != "unmigrated"
                or observed.get("minimumReaderLevel") not in (16, 17, 18)
                or observed.get("currentReaderRequirementSHA256") != target["readerRequirementSHA256"]
                or any(observed.get(key) != target.get(key) for key in
                       ("storeID", "replicaID", "readerRequirementSHA256", "clustered", "membershipDigest", "memberCount"))):
            refuse("layout17 inspection identity, membership or reader requirement changed")


def layout17_compatible_update(original, incoming):
    formats = incoming["canonicalFormats"]
    if (original.get("version") != LAYOUT17_FIRST or incoming.get("version") != LAYOUT17_CORRECTED
            or original.get("upgrade") != LAYOUT17_POLICIES[LAYOUT17_FIRST]
            or incoming.get("upgrade") != LAYOUT17_POLICIES[LAYOUT17_CORRECTED]
            or original.get("canonicalFormats") != formats
            or formats.get("readerLevel") != 20 or formats.get("writerLevel") != 20
            or original.get("arch") != incoming.get("arch")
            or original.get("semanticProfile") != incoming.get("semanticProfile")
            or original.get("embedding") != incoming.get("embedding")
            or layout17_document_semantics(original.get("documentExtraction"))
                != layout17_document_semantics(incoming.get("documentExtraction"))):
        refuse("the .17.1 compatible update differs from the committed .17 formats or semantics")


def layout17_released_receipts(receipts, old_digest, incoming):
    daemon_uid = pwd.getpwnam("daemon").pw_uid
    required = {"tractanda.physical-layout.flat-items.v1", "tractanda.message-items.v1"}
    for name, receipt in receipts.items():
        if receipt["state"] == "removed":
            continue
        store = receipt["store"]
        if (receipt["state"] != "active" or not receipt["initialized"]
                or receipt["manifestSHA256"] != old_digest
                or os.path.lexists(os.path.join(INSTALLATION, "layout17-intents", name + ".json"))
                or os.path.lexists(os.path.join(store, "canonical-layout.pending.json"))):
            refuse("complete the retained .17 package and administrator hold before updating")
        marker = decode_object(layout17_store_file(store, "canonical-layout.json", daemon_uid))
        fence = decode_object(layout17_store_file(store, "canonical-reader.json", daemon_uid))
        profile = decode_object(layout17_store_file(store, ".tractanda-personal-profile.json", daemon_uid))
        capabilities = fence.get("capabilities")
        if (marker != {"profile": "tractanda.physical-layout.v1", "layout": "flat-items-visible-attachments.v1",
                       "recordEncoding": "message-v1"}
                or fence.get("profile") != "tractanda.canonical-reader.v1"
                or profile.get("profile") != "tractanda.personal-workgroup.v1"
                or fence.get("storeID") != profile.get("storeID")
                or fence.get("minimumReaderLevel") != 20 or type(capabilities) is not list
                or not all(type(capability) is str for capability in capabilities)
                or not required <= set(capabilities) <= set(incoming["canonicalFormats"].get("capabilities", []))):
            refuse("the installed .17 store is not a completed compatible format-20 store")
        journal = layout17_journal_path(profile.get("storeID"), profile.get("replicaID"))
        if os.path.lexists(journal):
            root_directory_chain(os.path.dirname(journal))
            record = decode_object(read_private_regular(journal, 512 * 1024))
            if (record.get("phase") != "complete" or record.get("profile") != "tractanda.layout17-journal.v1"
                    or record.get("storeID") != profile["storeID"] or record.get("replicaID") != profile["replicaID"]
                    or not valid_digest(record.get("originalRequirementSHA256"))):
                refuse("finish the retained .17 migration journal before updating")


def layout17_replacement_pre_stop(incoming):
    """Check the immutable old .17 helper's inputs before it sees a compatible update."""
    raw = read_private_regular(os.path.join(ACTIVE, "bundle-manifest.json"),
                               16 * 1024 * 1024, private=False)
    manifest = decode_object(raw)
    if manifest.get("version") != LAYOUT17_FIRST:
        return
    state = decode_object(read_private_regular(STATE), STATE_REQUIRED, STATE_ALLOWED)
    if state.get("owner") is not None or state.get("startupPermitted") != []:
        refuse("a retained package transaction still owns the .17 installation")
    if state["phase"] == "committed":
        original = state.get("incoming")
    elif state["phase"] in ("quiesced", "awaitingUnpack", "failed") and state.get("incoming") == incoming:
        original = state.get("original")
    else:
        refuse("complete the exact retained .17 package transaction before updating")
    digest = hashlib.sha256(raw).hexdigest()
    if (type(original) is not dict or original.get("manifestSHA256") != digest
            or any(original.get(key) != manifest.get(key) for key in
                   ("version", "canonicalFormats", "arch", "embedding", "documentExtraction"))):
        refuse("the installed .17 manifest differs from its protected package commitment")
    layout17_compatible_update(original, incoming)
    if os.path.lexists(RECEIPTS):
        root_directory_chain(RECEIPTS)
        names = os.listdir(RECEIPTS)
        if len(names) > 1024 or any(not name.endswith(".json") or not valid_instance(name[:-5]) for name in names):
            refuse("invalid layout17 receipt inventory")
        instances = {name[:-5] for name in names}
    else:
        instances = set()
    layout17_released_receipts(read_receipts(instances, quiescent=False), digest, incoming)


def layout17_restore_original(helper, original, targets):
    """Reconfigure the real old payload only before any layout barrier or unpack."""
    daemon_uid = pwd.getpwnam("daemon").pw_uid
    for target in targets.values():
        store = target["store"]
        fence = decode_object(layout17_store_file(store, "canonical-reader.json", daemon_uid))
        if (fence.get("minimumReaderLevel") not in (16, 17, 18)
                or any(os.path.lexists(os.path.join(store, name)) for name in
                       ("canonical-layout.pending.json", "canonical-layout.json"))):
            refuse("layout17 could not restore old service intent across an unknown reader barrier")
    verify_helper(["verify-helper", helper])
    with tempfile.TemporaryDirectory(prefix="tractanda-layout17-restore-", dir="/run") as stage:
        path = os.path.join(stage, "descriptor.json")
        with open(path, "xb") as file:
            file.write(json.dumps(original, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode() + b"\n")
        os.chmod(path, 0o600)
        restored = subprocess.run([helper, "--package-lifecycle", "configure", "--descriptor", path],
                                  stdin=subprocess.DEVNULL, check=False)
        if restored.returncode:
            refuse("layout17 inspection failed and genuine16.2 service-intent recovery also failed")


def legacy_preinst_helper(arguments):
    """Retain genuine expected payload metadata only after the old helper stops.

    This is not payload/semantic admission. New configure still verifies the
    real unpacked inventory and current execution pins before activation.
    """
    if len(arguments) not in (4, 6) or arguments[3] not in LEGACY_DEBIAN_VERSIONS:
        refuse("unsupported legacy preinst source version")
    helper, path, version = arguments[1:4]
    verify_helper(["verify-helper", helper])
    incoming = validate_descriptor(path)
    if incoming.get("version") in LAYOUT17_POLICIES and version != "0.1.0~poc.16.2-1":
        refuse("install the authentic16.2 bridge source before upgrading to17")
    raw = read_private_regular(os.path.join(ACTIVE, "bundle-manifest.json"),
                               16 * 1024 * 1024, private=False)
    previous_manifest = decode_object(raw)
    previous_digest = hashlib.sha256(raw).hexdigest()
    if previous_manifest.get("version") != LEGACY_DEBIAN_VERSIONS[version]:
        refuse("legacy Debian version differs from the installed payload")
    targets = {}
    manager = contextlib.nullcontext(None)
    if version == "0.1.0~poc.16.2-1":
        if len(arguments) != 6:
            refuse("layout17 incoming control inspector is missing")
        targets = layout17_pre_stop(previous_manifest, previous_digest, incoming)
        manager = layout17_control_inspector(arguments[4], arguments[5], incoming)
    elif len(arguments) != 4:
        refuse("unexpected inspector arguments outside layout17")
    query = subprocess.run(
        ["/usr/bin/dpkg-query", "-W", "-f=${Status}\n${Version}\n", "tractanda"],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, check=False)
    lines = query.stdout.splitlines()
    # dpkg marks its normal upgrade preinst as reinstreq/half-installed before
    # unpack. This marker alone is not a diagnosis of a previous failed install.
    if (query.returncode != 0 or query.stderr or len(query.stdout.encode()) > 1024
            or len(lines) != 2 or lines[1] != version
            or lines[0] != "install reinstreq half-installed"):
        refuse("legacy preinst lacks the actual matching dpkg upgrade state")
    with manager as inspector:
        if inspector is not None:
            layout17_inspect_targets(inspector, targets)
        # The old SDK must never be asked to decode the new descriptor. It sees only
        # its own stopped payload/intent, before the protected expected binding changes.
        stopped = subprocess.run([helper, "--package-lifecycle", "prerm-upgrade"],
                                 stdin=subprocess.DEVNULL, check=False)
        if stopped.returncode != 0:
            raise SystemExit(stopped.returncode)
        state = safe_state()  # Actual stopped units, private receipts and writer locks.
        original = state.get("original")
        if (state["phase"] != "quiesced" or type(original) is not dict
                or original.get("manifestSHA256") != previous_digest
                or original.get("version") != LEGACY_DEBIAN_VERSIONS[version]
                or any(entry["originalManifestSHA256"] != previous_digest for entry in state["instances"])
                or state.get("incoming") not in (None, original, incoming)):
            refuse("legacy stopped transaction differs from the original installed payload")
        receipts = read_receipts({entry["name"] for entry in state["instances"]})
        if any(receipt["manifestSHA256"] != previous_digest for receipt in receipts.values()):
            refuse("legacy receipt is not bound to the original installed payload")
        if inspector is not None:
            if any(target["clustered"] and any(entry[key] for key in
                    ("wasRunning", "wasEnabled", "embeddingWasRunning", "authenticationWasRunning"))
                    for entry in state["instances"] if (target := targets.get(entry["name"])) is not None):
                refuse("prepared cluster intent was not captured stopped and disabled")
            try:
                layout17_inspect_targets(inspector, targets, quiescent=True)
            except (SystemExit, Exception):
                layout17_restore_original(helper, original, targets)
                raise
        state["incoming"] = incoming
        state["phase"] = "awaitingUnpack"
        state["startupPermitted"] = []
        state["owner"] = None
        state["recoveryReason"] = ("layout17-inspected-and-quiescent-awaiting-unpack" if inspector is not None
                                   else "verified-legacy-preinst-expected-payload-not-admission")
        write_state(state)
        return 0

# This leaf and receipt belong only to this installer. Never edit vendor units,
# administrator drop-ins, uuidd.socket, or libuuid's persistent clock state.
UUIDD_DROPIN = "/etc/systemd/system/uuidd.service.d/90-tractanda-normal-clock.conf"
UUIDD_RECEIPT = os.path.join(CONFIG_ROOT, "uuidd-normal-clock.json")
UUIDD_HEADER = "# Managed by Tractanda: UUIDv1 issuance uses the normal clock.\n"


def uuidd_run(arguments):
    budget = int(os.environ.get("TRACTANDA_UUIDD_TIMEOUT_SECONDS", "1800"))
    if not 1 <= budget <= 604800:
        refuse("invalid uuidd service-operation timeout")
    result = subprocess.run(arguments, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, timeout=budget, check=False)
    if result.returncode:
        refuse("uuidd service operation failed: " + " ".join(arguments))
    return result.stdout.strip()


def uuidd_command():
    raw = uuidd_run(["/usr/bin/systemctl", "show", "uuidd.service", "--property=ExecStart", "--value"])
    # systemctl's argv display is not shell syntax. Admit only an unambiguous
    # safe-token subset; never reinterpret quotes, escapes, specifiers or ';'.
    match = re.fullmatch(r"\{ path=(/usr/sbin/uuidd) ; argv\[\]=([A-Za-z0-9_./=:+ \-]+) ; ignore_errors=no ; [^{}]*\}", raw)
    if not match:
        refuse("unsupported uuidd ExecStart; administrator review required")
    args = match[2].split()
    if not args or args[0] != match[1] or "--socket-activation" not in args:
        refuse("uuidd must retain its supported executable and socket activation")
    return args


def uuidd_without_continuous(args):
    clean = []
    for arg in args:
        if arg == "--cont-clock" or re.fullmatch(r"--cont-clock=[0-9]+[hd]?", arg):
            continue
        if arg.startswith("--cont") or arg.startswith("-C"):
            refuse("ambiguous uuidd continuous-clock option")
        clean.append(arg)
    return clean


def uuidd_atomic(path, data, mode):
    parent = os.path.dirname(path)
    os.makedirs(parent, mode=0o755, exist_ok=True)
    root_directory_chain(parent)
    temporary = path + ".tractanda-new-" + str(uuid.uuid4())
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        with os.fdopen(fd, "wb", closefd=False) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(fd)
        os.replace(temporary, path)
        parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    finally:
        os.close(fd)
        os.unlink(temporary) if os.path.lexists(temporary) else None


def uuidd_owned_content():
    if not os.path.lexists(UUIDD_RECEIPT):
        if os.path.lexists(UUIDD_DROPIN):
            refuse("uuidd drop-in name collision; no ownership receipt")
        return None
    receipt = decode_object(read_private_regular(UUIDD_RECEIPT, 16384))
    content = receipt.get("content")
    if (set(receipt) != {"profile", "content"} or receipt["profile"] != "tractanda.uuidd-normal-clock.v1"
            or type(content) is not str or not content.startswith(UUIDD_HEADER)):
        refuse("invalid uuidd ownership receipt")
    if os.path.lexists(UUIDD_DROPIN):
        if read_private_regular(UUIDD_DROPIN, 8192, private=False) != content.encode():
            refuse("uuidd drop-in was modified; preserving administrator content")
    return content


def uuidd_reload_restart():
    uuidd_run(["/usr/bin/systemctl", "daemon-reload"])
    # deb-systemd-invoke honors policy-rc.d. A denied restart must never be
    # mistaken for changing an already running continuous-clock daemon.
    uuidd_run(["/usr/bin/deb-systemd-invoke", "try-restart", "uuidd.service"])


def uuidd_verify_running():
    pid = uuidd_run(["/usr/bin/systemctl", "show", "uuidd.service", "--property=MainPID", "--value"])
    if not pid.isdecimal():
        refuse("uuidd running PID is malformed")
    if int(pid):
        with open("/proc/" + pid + "/cmdline", "rb") as stream:
            args = [part.decode("ascii") for part in stream.read(8192).split(b"\0") if part]
        if uuidd_without_continuous(args) != args:
            refuse("uuidd still runs continuous-clock mode; restart may be policy-blocked")


def uuidd_configure():
    owned = uuidd_owned_content()
    args = uuidd_command()
    clean = uuidd_without_continuous(args)
    if owned is None and args == clean:
        uuidd_verify_running()
        return 0  # Already normal: do not take ownership of existing admin policy.
    content = UUIDD_HEADER + "[Service]\nExecStart=\nExecStart=" + " ".join(clean) + "\n"
    if owned is not None and content != owned:
        refuse("effective uuidd command changed outside owned policy; review required")
    if owned is None:
        receipt = json.dumps({"profile": "tractanda.uuidd-normal-clock.v1", "content": content}) + "\n"
        # Record intent first so failed installation/configuration is retryable.
        uuidd_atomic(UUIDD_RECEIPT, receipt.encode(), 0o600)
    uuidd_atomic(UUIDD_DROPIN, content.encode(), 0o644)
    uuidd_reload_restart()
    effective = uuidd_command()
    if uuidd_without_continuous(effective) != effective:
        refuse("a higher-priority uuidd configuration still enables continuous clock")
    uuidd_verify_running()
    return 0


def uuidd_unlink(path):
    os.unlink(path)
    parent_fd = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(parent_fd)
    finally:
        os.close(parent_fd)


def uuidd_remove():
    owned = uuidd_owned_content()
    if owned is None:
        return 0
    if os.path.lexists(UUIDD_DROPIN):
        uuidd_unlink(UUIDD_DROPIN)
    # Keep the receipt on failure; removal/purge can safely retry. Leave shared
    # directories, socket activation and daemon clock data exactly in place.
    uuidd_reload_restart()
    uuidd_unlink(UUIDD_RECEIPT)
    return 0


def fallback(arguments):
    if os.geteuid() != 0 or not arguments:
        refuse("root custody and a finite fallback action are required")
    action = arguments[0]
    if action == "configure-helper":
        if len(arguments) != 2:
            refuse("invalid configure-helper arguments")
        verify_helper(["verify-helper", arguments[1]])
        if LAYOUT in ("legacy", "migrating-current"):
            result = subprocess.run([arguments[1], "--migrate-system-layout"], check=False)
            if result.returncode != 0:
                refuse("explicit system layout migration failed")
            if select_layout() != "current":
                refuse("system layout migration did not complete")
            verify_helper(["verify-helper", arguments[1]])
        ensure_layout_aliases()
        return uuidd_configure()
    if action == "uuidd-remove":
        if len(arguments) != 1:
            refuse("invalid uuidd-remove arguments")
        return uuidd_remove()
    if action in ("layout17-abort-upgrade", "layout17-reinstall-abort", "layout17-compatible-abort"):
        reinstall = action == "layout17-reinstall-abort"
        compatible = action == "layout17-compatible-abort"
        if (len(arguments) != (2 if reinstall or compatible else 1)
                or (reinstall or compatible) and not valid_digest(arguments[1])):
            refuse("invalid layout17 abort arguments")
        try:
            state = decode_object(read_private_regular(STATE), STATE_REQUIRED, STATE_ALLOWED)
        except FileNotFoundError:
            return fallback(["postrm"])
        if state.get("phase") != "committed":
            return fallback(["postrm"])
        # A pre-stop refusal may leave the committed services running. Only
        # the genuine old payload or an exact reinstall can prove that case.
        raw = read_private_regular(os.path.join(ACTIVE, "bundle-manifest.json"),
                                   16 * 1024 * 1024, private=False)
        old = decode_object(raw)
        incoming = state.get("incoming")
        actual_digest = hashlib.sha256(raw).hexdigest()
        expected_versions = (LAYOUT17_POLICIES if reinstall else
                             (LAYOUT17_FIRST,) if compatible else ("0.1.0-poc.16.2",))
        if (state.get("profile") != "tractanda.package-transaction.v1"
                or old.get("version") not in expected_versions or type(incoming) is not dict
                or incoming.get("version") != old.get("version")
                or incoming.get("manifestSHA256") != actual_digest
                or state.get("owner") is not None or state.get("startupPermitted") != []
                or reinstall and arguments[1] != actual_digest
                or compatible and arguments[1] == actual_digest):
            if reinstall or compatible:
                return fallback(["postrm"])
            refuse("layout17 abort lacks the authentic committed old payload")
        return verify_helper(["verify-helper", os.path.join(ACTIVE, "bin/tractanda-setup")])
    if action == "postrm-remove":
        if len(arguments) != 1:
            refuse("invalid postrm-remove arguments")
        fallback(["postrm"])
        return uuidd_remove()
    if action == "verify-helper":
        return verify_helper(arguments)
    if action == "preinst-helper":
        if len(arguments) != 3:
            refuse("invalid preinst helper arguments")
        verify_helper(["verify-helper", arguments[1]])
        incoming = validate_descriptor(arguments[2])
        if incoming["version"] == LAYOUT17_CORRECTED:
            layout17_replacement_pre_stop(incoming)
        return 0
    if action == "legacy-preinst-helper":
        return legacy_preinst_helper(arguments)
    if action == "preinst":
        if len(arguments) != 3 or arguments[1] not in ("install", "upgrade"):
            refuse("invalid preinst fallback arguments")
        lifecycle, descriptor_path = arguments[1], arguments[2]
        descriptor = validate_descriptor(descriptor_path)
        try:
            os.lstat(STATE)
            has_state = True
        except FileNotFoundError:
            has_state = False
        if not has_state:
            if lifecycle != "install" or os.path.lexists(ACTIVE) or os.path.lexists(RECEIPTS):
                refuse("only a clean first install may proceed without an old helper")
            if listed_units(("list-units", "--all", "--no-legend", "--plain", "--full", "--type=service", "tractanda-*.service")):
                refuse("matching managed service exists")
            if listed_units(("list-unit-files", "--no-legend", "--no-pager", "tractanda-*.service")):
                refuse("matching managed unit file exists")
            return 0
        state = safe_state()
        if state["phase"] not in ("quiesced", "awaitingUnpack", "failed", "removed"):
            refuse("retained state is not eligible for missing-helper unpack")
        original = state.get("original") or {}
        if descriptor["version"] in LAYOUT17_POLICIES:
            if original.get("version") == descriptor["version"]:
                if descriptor != original or descriptor.get("upgrade") != LAYOUT17_POLICIES[descriptor["version"]]:
                    refuse("layout17 missing-helper reinstall differs from the committed .17 artifact")
            elif original.get("version") == LAYOUT17_FIRST and descriptor["version"] == LAYOUT17_CORRECTED:
                if state["phase"] != "awaitingUnpack" or state.get("incoming") != descriptor:
                    refuse("layout17 missing-helper update lacks the exact retained .17.1 commitment")
                layout17_compatible_update(original, descriptor)
                receipts = read_receipts({entry["name"] for entry in state["instances"]})
                layout17_released_receipts(receipts, original["manifestSHA256"], descriptor)
                return 0
            else:
                if (original.get("version") != "0.1.0-poc.16.2" or state["phase"] != "awaitingUnpack"
                        or state.get("incoming") != descriptor
                        or state.get("recoveryReason") != "layout17-inspected-and-quiescent-awaiting-unpack"):
                    refuse("layout17 missing-helper retry lacks the exact completed pre-unpack inspection")
                return 0
        state["incoming"] = descriptor
        state["phase"] = "awaitingUnpack"
        state["startupPermitted"] = []
        state["owner"] = None
        state["recoveryReason"] = "guarded-missing-helper-pre-unpack"
        write_state(state)
        return 0
    if action in ("prerm-upgrade", "postrm", "abort-remove"):
        if len(arguments) != 1:
            refuse("invalid validation-only arguments")
        try:
            os.lstat(STATE)
        except FileNotFoundError:
            if action in ("postrm", "abort-remove"):
                live = listed_units(("list-units", "--all", "--no-legend", "--plain", "--full", "--type=service", "tractanda-*.service"))
                files = listed_units(("list-unit-files", "--no-legend", "--no-pager", "tractanda-*.service"))
                if not live and not files:
                    return 0
            refuse("validation-only hook has no captured package state")
        state = safe_state()
        if action == "prerm-upgrade" and state["phase"] not in (
                "quiesced", "awaitingUnpack", "failed", "removed"):
            refuse("upgrade fallback lacks previously captured quiescent intent")
        if action == "abort-remove" and state["phase"] not in (
                "quiesced", "awaitingUnpack", "failed", "removed"):
            refuse("abort-remove fallback lacks previously captured quiescent intent")
        return 0
    if action == "remove":
        if len(arguments) != 1:
            refuse("invalid remove fallback arguments")
        state = safe_state()
        state["phase"] = "removed"
        state["startupPermitted"] = []
        state["owner"] = None
        state["recoveryReason"] = "guarded-missing-helper-remove"
        write_state(state)
        return 0
    refuse("unknown fallback action")

def main():
    try:
        select_layout()
        return fallback(sys.argv[1:])
    except SystemExit:
        raise
    except Exception as error:
        refuse("cannot prove safe package handoff: " + type(error).__name__)

if __name__ == "__main__":
    sys.exit(main())

