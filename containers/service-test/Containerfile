# Official Swift 6.4.0 Debian 12 release image; supports amd64 and arm64.
FROM docker.io/library/swift@sha256:4f4120422396f62788ef459c75fe1a47f8746471c224fdc2a7dd8dd2e07f7efd
# Run actual systemd user services inside a disposable Debian test VM/container.
RUN apt-get update && apt-get install -y --no-install-recommends python3 acl libpam0g-dev uuid-dev systemd dbus-user-session \
    && rm -rf /var/lib/apt/lists/*
