# Official Swift 6.4.0 Debian 12 release image; supports amd64 and arm64.
FROM docker.io/library/swift@sha256:4f4120422396f62788ef459c75fe1a47f8746471c224fdc2a7dd8dd2e07f7efd
# Independent wire clients and a kernel POSIX ACL comparison fixture.
RUN apt-get update && apt-get install -y --no-install-recommends python3 acl libsqlite3-dev libpam0g-dev uuid-dev \
    && rm -rf /var/lib/apt/lists/*
