#!/bin/sh
# Installer's private script directory contains the verified, signed release bundle.
set -eu
[ "${3:-/}" = / ] || { echo 'Install Tractanda on the running system volume.' >&2; exit 1; }
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle="$script_dir/bundle"
base='/Users/Shared/Library/Application Support/Tractanda'
registry="$base/connections.json"
instance=default

if [ -e "$registry" ]; then
    [ ! -L "$registry" ] && [ "$(/usr/bin/stat -f %u "$registry")" = 0 ] || {
        echo 'The system connection registry must be a regular root-owned file.' >&2; exit 1;
    }
    instance=$(/usr/bin/plutil -extract defaultProfile raw -o - "$registry") || {
        echo 'Select the installation explicitly with tractanda-setup; no system default is configured.' >&2; exit 1;
    }
fi
case "$instance" in ''|*[!a-z0-9-]*) echo 'Invalid default database name.' >&2; exit 1;; esac

if [ -f "$base/receipts/$instance.json" ]; then
    # Existing owner, data locations, model configuration and port are preserved.
    exec "$bundle/bin/tractanda-setup" upgrade --bundle "$bundle" --name "$instance"
fi

owner=$(/usr/bin/stat -f %Su /dev/console)
case "$owner" in ''|root|loginwindow|_mbsetupuser)
    echo 'Log in as the intended owner before installing, or use install.sh with an explicit --owner.' >&2
    exit 1;;
esac
exec "$bundle/bin/tractanda-setup" install --bundle "$bundle" --name "$instance" --owner "$owner" --sample
